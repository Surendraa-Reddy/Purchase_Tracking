<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="resetPasswordDialog"
        title="Reset / Create New Password"
        contentWidth="320px"
    >
        <content>
            <VBox class="sapUiContentPadding">
                <Label
                    text="Username"
                    required="true"
                    labelFor="resetUsernameInput"
                />
                <Input
                    id="resetUsernameInput"
                    placeholder="Enter your Username"
                />

                <Label
                    text="New Password"
                    required="true"
                    labelFor="resetNewPasswordInput"
                    class="sapUiTinyMarginTop"
                />
                <Input
                    id="resetNewPasswordInput"
                    type="Password"
                    placeholder="Enter new password"
                />

                <Label
                    text="Confirm New Password"
                    required="true"
                    labelFor="resetConfirmPasswordInput"
                    class="sapUiTinyMarginTop"
                />
                <Input
                    id="resetConfirmPasswordInput"
                    type="Password"
                    placeholder="Confirm new password"
                />
            </VBox>
        </content>
        <beginButton>
            <Button
                text="Submit"
                type="Emphasized"
                press="._handlePasswordResetSubmit"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press="._onCloseResetDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
