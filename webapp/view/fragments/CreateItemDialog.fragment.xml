<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form"
>
    <Dialog
        id="createItemDialog"
        title="Create New Line Item"
    >
        <content>
            <form:SimpleForm
                editable="true"
                layout="ColumnLayout"
            >
                <form:content>
                    <Label
                        text="Item Number"
                        required="true"
                    />
                    <Input
                        id="inputItemNo"
                        value=""
                        placeholder="e.g. 00010"
                    />
                    <Label
                        text="Material Number"
                        required="true"
                    />
                    <Input
                        id="inputMaterial"
                        value=""
                        placeholder="e.g. MAT-1003"
                    />

                    <Label text="Material Description" />
                    <Input
                        id="inputMaterialDesc"
                        value=""
                        placeholder="e.g. Wireless Mouse"
                    />

                    <Label
                        text="Plant"
                        required="true"
                    />
                    <Input
                        id="inputPlant"
                        value="1000"
                    />

                    <Label text="Storage Location" />
                    <Input
                        id="inputStorageLoc"
                        value="0001"
                    />

                    <Label
                        text="Quantity"
                        required="true"
                    />
                    <Input
                        id="inputQuantity"
                        type="Number"
                        value="1"
                    />

                    <Label text="Unit" />
                    <Input
                        id="inputUnit"
                        value="EA"
                    />

                    <Label
                        text="Net Price"
                        required="true"
                    />
                    <Input
                        id="inputNetPrice"
                        type="Number"
                        value="0.00"
                    />

                    <Label text="Currency" />
                    <Input
                        id="inputCurrency"
                        value="USD"
                    />
                    <Label text="Delivery Date" />
                    <DatePicker
                        id="inputDeliveryDate"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                        placeholder="Select Delivery Date..."
                    />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveItem"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseCreateDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
