<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
>
    <Dialog
        id="editPoItemDialog"
        title="Edit Purchase Order Line Item"
        contentWidth="500px"
    >
        <content>
            <f:SimpleForm
                editable="true"
                layout="ColumnLayout"
                columnsM="1"
                columnsL="1"
            >
                <f:content>
                    <Label text="PO ID" />
                    <Input
                        id="editPoIdItem"
                        value="{PoId}"
                        editable="false"
                    />

                    <Label text="Item No" />
                    <Input
                        id="editItemNo"
                        value="{ItemNo}"
                        editable="false"
                    />

                    <Label
                        text="Material"
                        required="true"
                    />
                    <Input
                        id="editMaterial"
                        value="{Material}"
                        maxLength="40"
                    />

                    <Label text="Material Desc" />
                    <Input
                        id="editMaterialDesc"
                        value="{MaterialDesc}"
                        maxLength="40"
                    />

                    <Label text="Plant" />
                    <Input
                        id="editPlant"
                        value="{Plant}"
                        maxLength="4"
                    />

                    <Label text="Storage Location" />
                    <Input
                        id="editStorageLoc"
                        value="{StorageLoc}"
                        maxLength="4"
                    />

                    <Label
                        text="Quantity"
                        required="true"
                    />
                    <Input
                        id="editQuantity"
                        value="{Quantity}"
                        type="Number"
                    />

                    <Label text="Unit" />
                    <Input
                        id="editUnit"
                        value="{Unit}"
                        maxLength="3"
                    />

                    <Label
                        text="Net Price"
                        required="true"
                    />
                    <Input
                        id="editNetPrice"
                        value="{NetPrice}"
                        type="Number"
                    />

                    <Label text="Currency" />
                    <Input
                        id="editCurrency"
                        value="{Currency}"
                        maxLength="5"
                    />

                    <Label text="Delivery Date" />
                    <DatePicker
                        id="editDeliveryDate"
                        value="{DeliveryDate}"
                        displayFormat="yyyy-MM-dd"
                        valueFormat="yyyy-MM-dd"
                    />
                </f:content>
            </f:SimpleForm>
        </content>
        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveEditPoItem"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancel"
                press=".onCloseEditItemDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
