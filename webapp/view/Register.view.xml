<mvc:View
    controllerName="purchaseordertracking.zpomanagementapp.controller.Register"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    displayBlock="true"
>
    <FlexBox
        height="100%"
        width="100%"
        alignItems="Center"
        justifyContent="Center"
        class="sapUiContentPadding sapUiResponsivePadding"
    >
        <f:Card width="380px">
            <f:header>
                <card:Header
                    title="Purchase Order Tracking"
                    subtitle="Create a new account"
                    iconSrc="sap-icon://add-employee"
                />
            </f:header>

            <f:content>
                <VBox
                    class="sapUiMediumMargin"
                    justifyContent="Center"
                >
                    <MessageStrip
                        id="regErrorMessage"
                        type="Error"
                        visible="false"
                        showIcon="true"
                        class="sapUiSmallMarginBottom"
                    />

                  
                    <Label
                        text="Username / User ID"
                        required="true"
                    />
                    <Input
                        id="regUsernameInput"
                        placeholder="Choose a username"
                        valueLiveUpdate="true"
                        class="sapUiSmallMarginBottom"
                    />

                    <Label
                        text="Password"
                        required="true"
                    />
                    <Input
                        id="regPasswordInput"
                        type="Password"
                        placeholder="Enter password"
                        valueLiveUpdate="true"
                        class="sapUiSmallMarginBottom"
                    />

                 
                    <Label
                        text="Confirm Password"
                        required="true"
                    />
                    <Input
                        id="regConfirmPasswordInput"
                        type="Password"
                        placeholder="Re-enter password"
                        valueLiveUpdate="true"
                        submit=".onRegisterSubmit"
                        class="sapUiMediumMarginBottom"
                    />

                    <Button
                        id="btnRegister"
                        text="Create Account"
                        type="Emphasized"
                        press=".onRegisterSubmit"
                        width="100%"
                        icon="sap-icon://accept"
                        class="sapUiSmallMarginBottom"
                    />

                    
                    <FlexBox justifyContent="Center">
                        <Link
                            text="Already have an account? Sign In"
                            press=".onNavBack"
                        />
                    </FlexBox>
                </VBox>
            </f:content>
        </f:Card>
    </FlexBox>
</mvc:View>
